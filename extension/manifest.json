{
  "manifest_version": 3,
  "name": "ChatExtra Toolkit",
  "version": "2.0.0",
  "description": "Export and organize ChatGPT conversations locally, save prompts, and send selected webpage content into ChatGPT.",
  "default_locale": "en",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "optional_host_permissions": [
    "https://chatgpt.com/*"
  ],
  "action": {
    "default_title": "ChatExtra Toolkit",
    "default_popup": "popup-entry.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background-entry.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
