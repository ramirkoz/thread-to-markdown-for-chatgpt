{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.9.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "contextMenus"
  ],
  "optional_host_permissions": [
    "https://chatgpt.com/*"
  ],
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "sidepanel.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background-entry.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
