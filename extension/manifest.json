{
  "manifest_version": 3,
  "name": "GPT Project & Memory Tools",
  "version": "2.26.0",
  "description": "Automatic local ChatGPT Project memory with resilient mixed-attachment export, large-video capture, filename alias coalescing, and content deduplication.",
  "default_locale": "en",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "optional_host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "action": {
    "default_title": "GPT Project & Memory Tools",
    "default_popup": "popup-entry.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background-entry.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
